# Postgres connection for the warehouse (see ARCHITECTURE.md#warehouse-schemas)
DATABASE_URL=postgresql://fpl:fpl@localhost:5432/fpl_engine

# Your FPL entry (team) id
FPL_ENTRY_ID=

# Discord incoming webhook URL for the weekly tip (see docs/adr/0001-architecture-and-stack.md)
DISCORD_WEBHOOK_URL=

# Local disk cache for FBref scrapes
FBREF_CACHE_DIR=.cache/fbref
